# Copy into .env and adapt. Then: COMPOSE_PROFILES=campus docker compose up -d
COMPOSE_PROFILES=campus
CNAAS_ENABLED=True

# ZTP network (VLAN where factory-default switches DHCP-boot). This host needs an address in it.
ZTP_HTTP_SERVER=10.100.2.2
ZTP_HTTP_BIND=10.100.2.2
ZTP_SUBNET=10.100.2.0
ZTP_NETMASK=255.255.255.0
ZTP_ROUTER=10.100.2.1
ZTP_RANGE_START=10.100.2.20
ZTP_RANGE_END=10.100.2.200

# Campus addressing used by the orchestrator (written to NetBox by task_bootstrap_campus)
CAMPUS_MGMT_PREFIX=10.100.0.0/24
CAMPUS_MGMT_VLAN=10
CAMPUS_LOOPBACK_PREFIX=10.100.255.0/24

# Device credentials CNaaS uses, and Junos password hashes (openssl passwd -6) for the templates.
# Keep them in sync with cnaas/templates/junos/dhcp-init.j2.
CNAAS_DEVICE_USERNAME=cnaas
CNAAS_DEVICE_PASSWORD=changeme
TEMPLATE_SECRET_ROOT_HASH=
TEMPLATE_SECRET_CNAAS_HASH=
CNAAS_JWT_SECRET_KEY=change-me-campus-secret
CNAAS_DB_PASSWORD=cnaas
